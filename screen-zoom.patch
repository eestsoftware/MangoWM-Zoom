diff --git a/src/dispatch/bind.c b/src/dispatch/bind.c
index 199ba887..68cc1141 100644
--- a/src/dispatch/bind.c
+++ b/src/dispatch/bind.c
@@ -2692,6 +2692,48 @@ int32_t dwindle_toggle_current_split(const Arg *arg) {
 	return 0;
 }
 
+/* Screen zoom functions */
+
+static void screen_zoom_start_animation(void) {
+	server.zoom_animating = 1;
+}
+
+int32_t screen_zoom_in(const Arg *arg) {
+	server.zoom_target += config.zoom_speed;
+	if (server.zoom_target > config.zoom_max)
+		server.zoom_target = config.zoom_max;
+	screen_zoom_start_animation();
+	request_fresh_all_monitors();
+	return 0;
+}
+
+int32_t screen_zoom_out(const Arg *arg) {
+	server.zoom_target -= config.zoom_speed;
+	if (server.zoom_target < 1.0f)
+		server.zoom_target = 1.0f;
+	screen_zoom_start_animation();
+	request_fresh_all_monitors();
+	return 0;
+}
+
+int32_t screen_zoom_reset(const Arg *arg) {
+	server.zoom_target = 1.0f;
+	screen_zoom_start_animation();
+	request_fresh_all_monitors();
+	return 0;
+}
+
+int32_t screen_zoom_set(const Arg *arg) {
+	server.zoom_target = arg->f;
+	if (server.zoom_target < 1.0f)
+		server.zoom_target = 1.0f;
+	if (server.zoom_target > config.zoom_max)
+		server.zoom_target = config.zoom_max;
+	screen_zoom_start_animation();
+	request_fresh_all_monitors();
+	return 0;
+    }
+
 int32_t focus_by_id(const Arg *arg) {
 	if (!server.selected_monitor || !arg->tc)
 		return 0;
